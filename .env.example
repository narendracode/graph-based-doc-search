# Copy to .env and adjust before running `make up`.

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Super admin bootstrapped on first seed — logs in like any other user.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=change-me

# Postgres and Redis are NOT run by docker-compose — point these at any reachable
# Postgres 14+ (with the `vector` extension available) and Redis instance. Use a
# dedicated database (and, for a shared Redis, a dedicated db index like /1) so this
# project's data and job queue stay isolated from anything else on that instance.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/nbcc_archive

REDIS_URL=redis://user:password@host:6379/1

# Must be unique whenever this REDIS_URL is shared with another deployment
# (e.g. local dev and a staging/EC2 box both pointed at the same dev Redis) —
# otherwise both workers listen on the identical queue and can steal each
# other's ingestion jobs, failing with "no such file" on whichever side didn't
# actually receive the upload. Leave as the default only if this Redis
# instance is exclusive to this one deployment.
QUEUE_NAME=ingestion

# Neo4j is NOT run by docker-compose either. Community Edition can't isolate
# multiple databases the way Postgres can — whatever instance you point at here
# should be dedicated entirely to this project, not shared with anything else.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Uses your host machine's Ollama (containers reach it via host.docker.internal) —
# no Ollama container, no duplicate model downloads. Pull these two on the host
# yourself if you don't already have them: `ollama pull nomic-embed-text` /
# `ollama pull llama3.1`. Swap OLLAMA_CHAT_MODEL for any chat model you already have.
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1:latest
EMBEDDING_DIM=768

STORAGE_DIR=./data/documents
WEB_ORIGIN=http://localhost:3020
NEXT_PUBLIC_API_URL=http://localhost:8020
